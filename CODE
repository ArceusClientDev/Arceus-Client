player.onChat("#arceus-status", function () {
    player.tell(mobs.target(LOCAL_PLAYER), "§5Verif For Patch")
    loops.pause(3000)
    player.tell(mobs.target(LOCAL_PLAYER), true)
    if (true) {
        gameplay.title(mobs.target(LOCAL_PLAYER), "§2Working", "§2Not Patched")
    } else {
        gameplay.title(mobs.target(LOCAL_PLAYER), "§4NotWorking", "§4Patched")
    }
})
